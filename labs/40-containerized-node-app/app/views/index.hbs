<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuoteBoard</title>
  <style>
    /* Base & reset */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f0f2f5;
      color: #333;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 3rem;
      margin-bottom: 2rem;
      color: #2c3e50;
      text-align: center;
    }

    /* Form */
    form {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
      max-width: 600px;
      margin-bottom: 2rem;
      background: #ffffff;
      padding: 1.5rem 2rem;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    input,
    textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 12px;
      border: 1px solid #ddd;
      font-size: 1rem;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
    }

    input:focus,
    textarea:focus {
      border-color: #3498db;
      box-shadow: 0 0 8px rgba(52, 152, 219, 0.3);
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }

    button {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      background: #3498db;
      color: #fff;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      align-self: flex-start;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(52, 152, 219, 0.3);
    }

    /* Quotes */
    .quote {
      background: #ffffff;
      padding: 1rem 1.5rem;
      margin-bottom: 1rem;
      border-left: 6px solid #3498db;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
      transition: transform 0.2s, box-shadow 0.2s;
      max-width: 600px;
      width: 100%;
    }

    .quote:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
    }

    .quote div:first-child {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }

    .quote div:last-child {
      font-size: 0.9rem;
      color: #3498db;
      text-align: right;
    }

    p {
      font-size: 1rem;
      color: #777;
      text-align: center;
      margin-top: 2rem;
    }
  </style>
</head>

<body>
  <h1>QuoteBoard</h1>

  <form method="post" action="/quotes">
    <input name="author" placeholder="Author (optional)" />
    <textarea name="text" placeholder="Write a quote..." required></textarea>
    <button type="submit">Add quote</button>
  </form>

  {{#if quotes.length}}
    {{#each quotes}}
      <div class="quote">
        <div>{{this.text}}</div>
        <div>— {{this.author}}</div>
      </div>
    {{/each}}
  {{else}}
    <p>No quotes yet. Add the first one.</p>
  {{/if}}
</body>

</html>
